# Copia este archivo como .env y llena los datos de tu base de datos.
# El .env nunca debe subirse a git.
DB_SERVER_NAME=localhost
DB_PORT=3306
USER_NAME=locateme
PASSWORD=
DB=locateme

# true muestra el detalle de los errores (sólo en tu computadora, nunca en producción)
APP_DEBUG=false

# false impide crear cuentas nuevas (útil cuando tu familia ya está registrada)
ALLOW_REGISTRATION=true

# Días que se guarda el historial de ubicaciones
LOCATION_RETENTION_DAYS=30
