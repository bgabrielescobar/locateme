RewriteEngine On

# Nunca servir archivos privados: .env, .git, código PHP, dependencias, esquema de la BD
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(vendor|database)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|README\.md|testfile\.txt)$ - [F,L]
RewriteRule ^src/(?!public/) - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
